# Wild Roots — .gitattributes
# По умолчанию: текст нормализуется в LF.
* text=auto eol=lf

# Скрипты Windows — CRLF (cmd.exe не всегда понимает LF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Скрипты Unix — строго LF
gradlew text eol=lf
*.sh    text eol=lf

# Двоичные файлы
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ogg  binary
*.wav  binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.gz   binary
# Структурные шаблоны (GameTest, old_save_vN — архитектура §5.4) и данные мира
*.nbt  binary
*.dat  binary
*.mca  binary
